# Copy to .env (never commit .env) or set these as environment variables.
# The scripts read .env from the repository folder; real environment variables win.

# Variant A: translation with Claude (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Variants A and B: ElevenLabs (elevenlabs.io -> Developers -> API keys)
ELEVENLABS_API_KEY=
# Variant A: id of YOUR cloned voice (ElevenLabs -> Voices -> your voice -> copy voice ID)
ELEVENLABS_VOICE_ID=

# Variant C: python of the separate OmniVoice venv (default: omni-env/Scripts/python.exe here)
# OMNI_PY=omni-env/bin/python
